      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "categories": ["business", "productivity", "news"],
  "shortcuts": [
    {
      "name": "Calendar",
      "short_name": "Calendar",
